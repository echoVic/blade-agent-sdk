{
  "name": "blade-agent-sdk-monorepo",
  "version": "1.0.12",
  "private": true,
  "description": "Blade AI Agent SDK monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/echoVic/blade-agent-sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "build": "pnpm --filter @blade-ai/agent-sdk run build",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"src/__tests__/integration.test.ts\" --exclude \"src/__tests__/*.live.test.ts\" --exclude \"src/services/__tests__/*.live.test.ts\" --exclude \"src/services/__tests__/deepseek-deep.live.test.ts\"",
    "test:integration": "vitest run src/__tests__/integration.test.ts",
    "test:integration:live": "INTEGRATION_LIVE=1 vitest run src/__tests__/integration.test.ts",
    "test:live:glm": "pnpm --filter @blade-ai/ai run build && node scripts/test-live-glm.mjs",
    "test:live:session-glm": "pnpm --filter @blade-ai/ai run build && pnpm --filter @blade-ai/agent run build && pnpm --filter @blade-ai/agent-sdk run build && node scripts/test-live-session-glm.mjs",
    "lint": "biome lint src packages",
    "lint:fix": "biome lint --write src packages",
    "type-check": "tsc --noEmit",
    "verify": "pnpm run lint && pnpm run type-check && pnpm -r run type-check && pnpm run verify:examples && pnpm run verify:boundaries && pnpm run docs:build && pnpm run verify:entrypoints && pnpm run verify:packages && pnpm run verify:release && pnpm run test:unit && pnpm run test:integration",
    "verify:examples": "tsc -p examples/tsconfig.json --noEmit",
    "verify:boundaries": "node scripts/verify-package-boundaries.mjs",
    "verify:entrypoints": "pnpm --filter @blade-ai/agent-sdk run build && node scripts/verify-entrypoints.mjs",
    "verify:packages": "pnpm --filter @blade-ai/ai run build && pnpm --filter @blade-ai/agent run build && pnpm --filter @blade-ai/agent-sdk run build && node scripts/verify-packages.mjs",
    "verify:release": "node scripts/verify-release-config.mjs",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "release:legacy": "node scripts/release.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "sdk",
    "blade",
    "ai",
    "assistant",
    "agent",
    "llm",
    "node"
  ],
  "author": "echoVic",
  "license": "MIT",
  "optionalDependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/azure": "^3.0.54",
    "@ai-sdk/deepseek": "^2.0.29",
    "@ai-sdk/google": "^3.0.64",
    "@vscode/ripgrep": "^1.17.0",
    "node-pty": "1.0.0"
  },
  "dependencies": {
    "@blade-ai/agent": "workspace:*",
    "@blade-ai/ai": "workspace:*",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.168",
    "async-mutex": "^0.5.0",
    "axios": "^1.15.2",
    "chalk": "^5.6.2",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.14",
    "js-tiktoken": "^1.0.21",
    "lodash-es": "^4.17.21",
    "lru-cache": "^11.3.5",
    "nanoid": "^5.1.9",
    "open": "^11.0.0",
    "picomatch": "^4.0.4",
    "semver": "^7.7.4",
    "undici": "^7.16.0",
    "write-file-atomic": "^7.0.1",
    "ws": "^8.20.0",
    "yaml": "^2.8.3",
    "zod": "^3.25.2",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/json-schema": "^7.0.15",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.0",
    "@types/picomatch": "^4.0.2",
    "@types/semver": "^7.7.1",
    "@types/write-file-atomic": "^4.0.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "semantic-release": "^25.0.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
