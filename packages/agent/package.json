{
  "name": "@blade-ai/agent",
  "version": "0.0.0",
  "description": "Runtime-independent Blade Agent kernel contracts",
  "author": "echoVic",
  "license": "MIT",
  "homepage": "https://github.com/echoVic/blade-agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/echoVic/blade-agent-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/echoVic/blade-agent-sdk",
    "directory": "packages/agent"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/AgentKernel.d.ts",
      "import": "./dist/kernel/AgentKernel.js"
    },
    "./loop": {
      "types": "./dist/loop/index.d.ts",
      "import": "./dist/loop/index.js"
    },
    "./budget": {
      "types": "./dist/budget/TokenBudget.d.ts",
      "import": "./dist/budget/TokenBudget.js"
    },
    "./epoch": {
      "types": "./dist/epoch/ExecutionEpoch.d.ts",
      "import": "./dist/epoch/ExecutionEpoch.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.js"
    },
    "./recovery": {
      "types": "./dist/recovery/index.d.ts",
      "import": "./dist/recovery/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    },
    "./tracing": {
      "types": "./dist/tracing/index.d.ts",
      "import": "./dist/tracing/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "agent",
    "sdk",
    "llm",
    "kernel",
    "runtime-independent",
    "tools"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@blade-ai/ai": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
