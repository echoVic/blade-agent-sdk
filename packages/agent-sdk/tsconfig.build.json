{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../src",
    "outDir": "./dist",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  "include": ["../../src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "../../src/**/*.test.ts",
    "../../src/**/*.spec.ts",
    "../../src/**/__tests__/**"
  ]
}
