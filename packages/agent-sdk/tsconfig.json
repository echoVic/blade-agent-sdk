{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "./dist",
    "noEmit": true,
    "paths": {
      "@/*": ["../../src/*"],
      "@blade-ai/agent": ["../agent/src/index.ts"],
      "@blade-ai/ai": ["../ai/src/index.ts"],
      "@blade-ai/ai/chat": ["../ai/src/chat/index.ts"],
      "@blade-ai/ai/deepseek": ["../ai/src/deepseek/index.ts"],
      "@blade-ai/ai/model": ["../ai/src/model/index.ts"],
      "@blade-ai/ai/providers/openai-compatible": ["../ai/src/providers/openai-compatible/index.ts"],
      "@blade-ai/ai/retry": ["../ai/src/retry/index.ts"]
    }
  },
  "include": ["src/**/*", "../../src/**/*"]
}
