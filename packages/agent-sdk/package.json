{
  "name": "@blade-ai/agent-sdk",
  "version": "0.0.0",
  "description": "Session-first Blade Agent SDK",
  "author": "echoVic",
  "license": "MIT",
  "homepage": "https://github.com/echoVic/blade-agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/echoVic/blade-agent-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/echoVic/blade-agent-sdk",
    "directory": "packages/agent-sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "browser": "./dist/core/index.js",
      "import": "./dist/core/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/browser/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "browser": "./dist/browser/server-only-stub.js",
      "import": "./dist/server/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "browser": "./dist/browser/server-only-stub.js",
      "import": "./dist/session/index.js"
    },
    "./session/internal": {
      "types": "./dist/session/internal.d.ts",
      "browser": "./dist/browser/server-only-stub.js",
      "import": "./dist/session/internal.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "browser": "./dist/tools/index.js",
      "import": "./dist/tools/index.js"
    },
    "./tools/builtin": {
      "types": "./dist/tools/builtin/index.d.ts",
      "browser": "./dist/tools/builtin/index.js",
      "import": "./dist/tools/builtin/index.js"
    },
    "./tools/public": {
      "types": "./dist/tools/public.d.ts",
      "browser": "./dist/tools/public.js",
      "import": "./dist/tools/public.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "browser": "./dist/errors/index.js",
      "import": "./dist/errors/index.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "browser": "./dist/browser/server-only-stub.js",
      "import": "./dist/local/index.js"
    },
    "./local/public": {
      "types": "./dist/local/public.d.ts",
      "browser": "./dist/browser/server-only-stub.js",
      "import": "./dist/local/public.js"
    },
    "./subagents": {
      "types": "./dist/subagents/index.d.ts",
      "browser": "./dist/subagents/index.js",
      "import": "./dist/subagents/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist",
    "vendor/ripgrep/**",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "agent",
    "sdk",
    "llm",
    "session-first",
    "mcp",
    "tools",
    "server"
  ],
  "scripts": {
    "build": "pnpm --filter @blade-ai/ai run build && pnpm --filter @blade-ai/agent run build && tsup --config tsup.config.ts && tsc -p tsconfig.build.json && tsc -p tsconfig.public-dts.json && node scripts/overlay-public-dts.mjs",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@blade-ai/agent": "workspace:*",
    "@blade-ai/ai": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "async-mutex": "0.5.0",
    "axios": "1.15.2",
    "chalk": "5.6.2",
    "diff": "9.0.0",
    "fast-glob": "3.3.3",
    "fuse.js": "7.3.0",
    "gray-matter": "4.0.3",
    "hono": "4.12.14",
    "js-tiktoken": "1.0.21",
    "lodash-es": "4.17.23",
    "lru-cache": "11.3.5",
    "nanoid": "5.1.9",
    "open": "11.0.0",
    "picomatch": "4.0.4",
    "semver": "7.7.4",
    "undici": "7.24.6",
    "write-file-atomic": "7.0.1",
    "ws": "8.20.0",
    "yaml": "2.8.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2",
    "zustand": "5.0.12"
  },
  "optionalDependencies": {
    "@vscode/ripgrep": "1.17.1",
    "node-pty": "1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
