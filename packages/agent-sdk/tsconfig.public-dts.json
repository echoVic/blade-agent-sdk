{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  "files": [
    "src/core/index.ts",
    "src/public-index.ts",
    "src/local/public-index.ts",
    "src/session/Session.ts",
    "src/session/config.ts",
    "src/session/factory.ts",
    "src/session/public-index.ts",
    "src/session/store.ts",
    "src/subagents/index.ts",
    "src/tools/public-index.ts",
    "src/types/permissions.ts"
  ],
  "include": [],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**"
  ]
}
