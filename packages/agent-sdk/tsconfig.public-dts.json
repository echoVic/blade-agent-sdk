{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "paths": {
      "@blade-ai/agent": ["../agent/dist/index.d.ts"],
      "@blade-ai/agent/budget": ["../agent/dist/budget/TokenBudget.d.ts"],
      "@blade-ai/agent/epoch": ["../agent/dist/epoch/ExecutionEpoch.d.ts"],
      "@blade-ai/agent/kernel": ["../agent/dist/kernel/AgentKernel.d.ts"],
      "@blade-ai/agent/loop": ["../agent/dist/loop/index.d.ts"],
      "@blade-ai/agent/ports": ["../agent/dist/ports/index.d.ts"],
      "@blade-ai/agent/protocol": ["../agent/dist/protocol/index.d.ts"],
      "@blade-ai/agent/state": ["../agent/dist/state/index.d.ts"],
      "@blade-ai/agent/tracing": ["../agent/dist/tracing/index.d.ts"],
      "@blade-ai/ai": ["../ai/dist/index.d.ts"],
      "@blade-ai/ai/chat": ["../ai/dist/chat/index.d.ts"],
      "@blade-ai/ai/deepseek": ["../ai/dist/deepseek/index.d.ts"],
      "@blade-ai/ai/model": ["../ai/dist/model/index.d.ts"],
      "@blade-ai/ai/providers/openai-compatible": [
        "../ai/dist/providers/openai-compatible/index.d.ts"
      ],
      "@blade-ai/ai/providers/vercel": ["../ai/dist/providers/vercel/index.d.ts"],
      "@blade-ai/ai/retry": ["../ai/dist/retry/index.d.ts"]
    }
  },
  "files": [
    "src/core/index.ts",
    "src/errors/index.ts",
    "src/public-index.ts",
    "src/local/public-index.ts",
    "src/session/Session.ts",
    "src/session/config.ts",
    "src/session/factory.ts",
    "src/session/public-index.ts",
    "src/session/store.ts",
    "src/subagents/index.ts",
    "src/tools/public-index.ts",
    "src/types/permissions.ts"
  ],
  "include": [],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**"
  ]
}
